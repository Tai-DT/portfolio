---
import type { Dictionary } from '../i18n/types';
import { PROJECTS } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';

interface Props {
  dict: Dictionary;
}
const { dict } = Astro.props;
const subtitle = `${dict.projects.subtitlePre}${PROJECTS.length}${dict.projects.subtitlePost}`;
---

<section id="projects" class="relative mx-auto max-w-5xl scroll-mt-24 px-6 py-24">
  <SectionHeading title={dict.projects.title} subtitle={subtitle} />

  <div class="grid gap-6 md:grid-cols-2">
    {PROJECTS.map((project, i) => (
      <article
        data-reveal
        data-tilt
        style={`--reveal-delay:${(i % 2) * 120}ms`}
        class:list={['relative', project.featured && 'md:col-span-2 lg:col-span-1']}
      >
        <div class="tilt-inner glass card-hover relative flex h-full flex-col rounded-2xl p-6">
          <div class="tilt-glare"></div>
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="font-mono text-xs uppercase tracking-widest text-aurora-2">{project.category}</p>
              <h3 class="mt-1.5 text-lg font-bold">{project.title}</h3>
              <p class="mt-0.5 text-sm text-muted-foreground">{project.tagline}</p>
            </div>
            {project.badge && (
              <span class="shrink-0 rounded-full border border-aurora-1/40 bg-aurora-1/10 px-2.5 py-1 font-mono text-[11px] text-aurora-2">
                {project.badge}
              </span>
            )}
          </div>

          <p class="mt-4 flex-1 text-sm leading-relaxed text-muted-foreground">{project.description}</p>

          <div class="mt-5 flex flex-wrap gap-1.5">
            {project.tags.map((tag) => (
              <span class="rounded-md bg-secondary px-2 py-0.5 text-[11px] text-secondary-foreground">{tag}</span>
            ))}
          </div>

          <div class="mt-5 flex items-center gap-3 text-sm font-medium">
            <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-aurora-2 transition-colors hover:text-aurora-1">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.72-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.66.41.36.78 1.05.78 2.12v3.15c0 .3.21.66.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
              {dict.projects.sourceCode}
            </a>
            {project.demoUrl && (
              <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-muted-foreground transition-colors hover:text-foreground">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
                {dict.projects.visitDemo}
              </a>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
