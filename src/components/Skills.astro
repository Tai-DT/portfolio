---
import type { Dictionary } from '../i18n/types';
import { SKILL_CATEGORIES } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';

interface Props {
  dict: Dictionary;
}
const { dict } = Astro.props;
const levelColor: Record<string, string> = {
  Expert: 'text-aurora-2 border-aurora-2/40 bg-aurora-2/10',
  Advanced: 'text-aurora-1 border-aurora-1/40 bg-aurora-1/10',
  Intermediate: 'text-muted-foreground border-border bg-secondary/60',
};
---

<section id="skills" class="relative mx-auto max-w-5xl scroll-mt-24 px-6 py-24">
  <SectionHeading title={dict.skills.title} subtitle={dict.skills.subtitle} />

  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {SKILL_CATEGORIES.map((cat, i) => (
      <div data-reveal data-tilt style={`--reveal-delay:${(i % 3) * 100}ms`} class="relative">
        <div class="tilt-inner glass card-hover relative h-full rounded-2xl p-5">
          <div class="tilt-glare"></div>
          <h3 class="font-semibold">{cat.title}</h3>
          <ul class="mt-4 space-y-3">
            {cat.skills.map((skill) => (
              <li class="flex items-start justify-between gap-3 text-sm">
                <div class="min-w-0">
                  <p class="font-medium leading-snug">{skill.name}</p>
                  <p class="mt-0.5 text-xs leading-snug text-muted-foreground">{skill.description}</p>
                </div>
                <span class:list={['shrink-0 rounded-full border px-2 py-0.5 text-[10px] font-semibold', levelColor[skill.level] ?? levelColor.Intermediate]}>
                  {skill.level}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>
