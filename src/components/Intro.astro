---
interface Props {
  fullName: string;
  role: string;
  domain: string;
}
const { fullName, role, domain } = Astro.props;
---

<div id="intro-overlay" aria-hidden="true">
  <div class="aurora-blob aurora-blob-1"></div>
  <div class="aurora-blob aurora-blob-2"></div>
  <div class="relative flex flex-col items-center gap-5 px-6 text-center">
    <div class="intro-logo btn-gradient flex h-24 w-24 items-center justify-center rounded-3xl text-4xl font-black shadow-2xl">
      TD
    </div>
    <h1 class="intro-name text-gradient text-3xl font-black tracking-tight sm:text-4xl">{fullName}</h1>
    <p class="intro-role text-sm tracking-wide text-muted-foreground">{role}</p>
    <div class="intro-bar mt-2 h-0.5 w-52 rounded-full bg-gradient-to-r from-aurora-1 via-aurora-3 to-aurora-2"></div>
    <p class="intro-role font-mono text-xs tracking-widest text-muted-foreground/60">{domain}</p>
  </div>
</div>
<script is:inline>
  (() => {
    try {
      const overlay = document.getElementById('intro-overlay');
      if (!overlay) return;
      if (sessionStorage.getItem('portfolio-intro-seen')) {
        overlay.remove();
      } else {
        sessionStorage.setItem('portfolio-intro-seen', '1');
        overlay.addEventListener('animationend', () => overlay.remove());
        setTimeout(() => overlay.remove(), 4000);
      }
    } catch {}
  })();
</script>
