---
import type { Dictionary, Locale } from '../i18n/types';
import { LOCALES } from '../i18n';
import { PERSONAL_INFO } from '../data/portfolio';

interface Props {
  locale: Locale;
  dict: Dictionary;
}
const { locale, dict } = Astro.props;
const nav = [
  { href: '#about', label: dict.nav.about },
  { href: '#projects', label: dict.nav.projects },
  { href: '#skills', label: dict.nav.skills },
  { href: '#guestbook', label: dict.nav.guestbook },
  { href: '#contact', label: dict.nav.contact },
];
---

<header class="glass sticky top-3 z-40 mx-3 mt-3 rounded-2xl sm:mx-auto sm:max-w-5xl">
  <div class="flex h-14 items-center justify-between gap-3 px-4 sm:px-6">
    <a href={`/${locale}`} class="flex items-center gap-2.5 font-bold tracking-tight">
      <span class="btn-gradient flex h-8 w-8 items-center justify-center rounded-lg text-sm font-black">TD</span>
      <span class="hidden sm:inline">{PERSONAL_INFO.domain}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {nav.map((item) => (
        <a
          href={item.href}
          class="rounded-lg px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <div class="glass flex items-center rounded-lg p-0.5 text-xs font-semibold" role="group" aria-label={dict.language.label}>
        {LOCALES.map((l) => (
          <a
            href={`/${l}`}
            hreflang={l === 'jp' ? 'ja' : l}
            class:list={[
              'rounded-md px-2.5 py-1 uppercase transition-colors',
              l === locale ? 'btn-gradient' : 'text-muted-foreground hover:text-foreground',
            ]}
            aria-current={l === locale ? 'true' : undefined}
          >
            {l === 'jp' ? 'JA' : l}
          </a>
        ))}
      </div>

      <button
        type="button"
        data-theme-toggle
        class="glass flex h-9 w-9 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:text-foreground"
        aria-label="Toggle theme"
      >
        <svg data-icon-sun class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg data-icon-moon class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>
    </div>
  </div>
</header>
