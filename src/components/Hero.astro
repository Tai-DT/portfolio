---
import type { Dictionary } from '../i18n/types';
import { PERSONAL_INFO } from '../data/portfolio';
import ThreeHero from './react/ThreeHero';

interface Props {
  dict: Dictionary;
}
const { dict } = Astro.props;
const greeting = dict.hero.greeting.replace('{name}', PERSONAL_INFO.fullName);
const edgeHosted = dict.hero.edgeHosted.replace('{domain}', PERSONAL_INFO.domain);
---

<section class="relative flex min-h-[calc(100svh-4.5rem)] items-center overflow-hidden">
  <div class="pointer-events-none absolute inset-0">
    <ThreeHero client:only="react" transition:persist />
  </div>

  <div class="relative z-10 mx-auto w-full max-w-5xl px-6 py-20">
    <div class="max-w-2xl">
      <p data-reveal class="glass inline-flex items-center gap-2 rounded-full py-1.5 pl-1.5 pr-4 text-sm text-muted-foreground">
        <img
          src={PERSONAL_INFO.avatarUrl}
          alt={PERSONAL_INFO.fullName}
          width={28}
          height={28}
          class="h-7 w-7 rounded-full border border-aurora-1/40 object-cover"
        />
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-aurora-1 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-aurora-1"></span>
        </span>
        {dict.hero.status}
      </p>

      <h1 data-reveal style="--reveal-delay:120ms" class="text-gradient mt-6 text-5xl font-bold leading-[1.05] tracking-tight sm:text-7xl">
        {greeting}
      </h1>

      <p data-reveal style="--reveal-delay:240ms" class="mt-6 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg">
        {dict.hero.bio}
      </p>

      <div data-reveal style="--reveal-delay:300ms" class="mt-6 flex flex-wrap gap-2">
        {dict.hero.highlights.map((h) => (
          <span class="glass rounded px-3.5 py-1.5 font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-foreground/85">
            {h}
          </span>
        ))}
      </div>

      <div data-reveal style="--reveal-delay:360ms" class="mt-9 flex flex-wrap items-center gap-3">
        <a href="#projects" class="btn-gradient rounded-xl px-6 py-3 text-sm font-semibold">
          {dict.hero.viewWork}
        </a>
        <a href="#contact" class="glass card-hover rounded-xl px-6 py-3 text-sm font-semibold">
          {dict.hero.getInTouch}
        </a>
      </div>

      <p data-reveal style="--reveal-delay:480ms" class="mt-10 font-mono text-xs tracking-wider text-muted-foreground/70">
        {edgeHosted}
      </p>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 z-10 -translate-x-1/2" aria-hidden="true">
    <div class="scroll-line"></div>
  </div>
</section>
