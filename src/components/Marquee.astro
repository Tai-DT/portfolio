---
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<div class="marquee relative border-y border-border/50 py-4" aria-hidden="true">
  <div class="marquee-track">
    {[0, 1].map(() => (
      <div class="flex shrink-0 items-center gap-8 pr-8">
        {items.map((item) => (
          <span class="flex items-center gap-8 whitespace-nowrap text-sm font-semibold tracking-wide text-muted-foreground/80">
            {item}
            <span class="h-1 w-1 rounded-full bg-aurora-2/70"></span>
          </span>
        ))}
      </div>
    ))}
  </div>
</div>
