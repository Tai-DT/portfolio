---
interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<div data-reveal class="mb-12">
  <h2 class="text-gradient inline-block text-3xl font-black tracking-tight sm:text-4xl">{title}</h2>
  <div class="mt-3 h-1 w-16 rounded-full bg-gradient-to-r from-aurora-1 to-aurora-2"></div>
  {subtitle && <p class="mt-4 max-w-2xl leading-relaxed text-muted-foreground">{subtitle}</p>}
</div>
