---
export const prerender = true;

const links = [
  { href: '/en/', label: 'English', lang: 'en' },
  { href: '/vi/', label: 'Tiếng Việt', lang: 'vi' },
  { href: '/jp/', label: '日本語', lang: 'ja' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — Page not found · taido.dev</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      :root {
        color-scheme: dark;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0e0a1a;
        color: #f1eefc;
        font-family:
          system-ui,
          -apple-system,
          'Segoe UI',
          sans-serif;
      }
      .card {
        text-align: center;
        padding: 3rem 2rem;
      }
      .code {
        font-size: 5rem;
        font-weight: 900;
        background: linear-gradient(120deg, #a78bfa, #67e8f9, #e879f9);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        line-height: 1;
      }
      p {
        color: #a9a3c7;
        margin: 1rem 0 2rem;
      }
      .links {
        display: flex;
        gap: 0.75rem;
        justify-content: center;
      }
      .links a {
        padding: 0.6rem 1.25rem;
        border-radius: 0.75rem;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.875rem;
        color: #f1eefc;
        background: linear-gradient(120deg, #7c3aed, #0891b2);
        transition: opacity 0.2s;
      }
      .links a:hover {
        opacity: 0.85;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="code">404</div>
      <p>Page not found · Không tìm thấy trang · ページが見つかりません</p>
      <nav class="links">
        {links.map((l) => <a href={l.href} hreflang={l.lang}>{l.label}</a>)}
      </nav>
    </div>
  </body>
</html>
